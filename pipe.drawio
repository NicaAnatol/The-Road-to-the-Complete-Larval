        <mxCell id="footer" value="Screening labels are preliminary; the full-text review and historical synthesis are still to come." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;fontColor=#D1D5DB;fontSize=17;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="35" y="925" width="1130" height="48" as="geometry"/>
