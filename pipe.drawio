<mxfile host="app.diagrams.net" modified="2026-11-11T14:50:00.000Z" agent="diagrams.net" version="24.7.17" type="device">
  <diagram id="research-pipeline" name="Research pipeline">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" background="#000000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="HOW LARVAL CONNECTOME RESEARCH BECAME POSSIBLE" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#F3F4F6;" vertex="1" parent="1">
          <mxGeometry x="25" y="20" width="1150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Current evidence and next steps in the historical systematic review." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#D1D5DB;" vertex="1" parent="1">
          <mxGeometry x="35" y="78" width="1130" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;1. SEARCH + TITLE/ABSTRACT SCREENING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A5C8FF&quot;&gt;CURRENT DATASET&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;Scopus API: 488 unique; WoS exports: 447&lt;br&gt;935 identified -&gt; 124 outside years -&gt; 811&lt;br&gt;257 duplicates removed -&gt; 554 screened&lt;br&gt;ASReview: 32 relevant | 507 excluded | 15 unclear&lt;br&gt;487 abstracts available; 67 missing&lt;br&gt;&lt;b&gt;Next:&lt;/b&gt; full-text review and resolve unclear records&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#F3F4F6;fontSize=18;align=center;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="35" y="155" width="530" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="analysis" value="&lt;b&gt;2. PRELIMINARY BIBLIOMETRIC PROFILE&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A5C8FF&quot;&gt;INITIAL ANALYSIS COMPLETED&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;Full corpus: publication output and citation profile&lt;br&gt;Relevant set (32): authors, affiliations, keywords&lt;br&gt;Keyword co-occurrence and co-authorship maps&lt;br&gt;Publication years 2010-2026; 2026 is partial&lt;br&gt;&lt;b&gt;Purpose:&lt;/b&gt; identify sources for deeper review&lt;br&gt;All results remain preliminary until eligibility is confirmed&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#F3F4F6;fontSize=18;align=center;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="635" y="155" width="530" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="extraction" value="&lt;b&gt;3. FULL-TEXT REVIEW + HISTORICAL EXTRACTION&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A5C8FF&quot;&gt;NEXT&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;Resolve 15 unclear labels and 1 duplicate candidate pair&lt;br&gt;Assess full texts for relevance and eligibility&lt;br&gt;Extract EM acquisition, alignment, tracing, synapses&lt;br&gt;Record developmental stage and validation methods&lt;br&gt;Compare neurons, synapses, image volume, and coverage&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; source-linked milestone evidence&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#F3F4F6;fontSize=18;align=center;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="635" y="565" width="530" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="synthesis" value="&lt;b&gt;4. HISTORICAL SYNTHESIS + RESEARCH GAPS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A5C8FF&quot;&gt;FINAL REVIEW OUTPUT&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;Explain how technical advances enabled larger reconstructions&lt;br&gt;Compare dataset scale and coverage across milestones&lt;br&gt;Distinguish measured values from author claims&lt;br&gt;Identify gaps in imaging, annotation, and validation&lt;br&gt;Relate the evidence to a more complete connectome&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; evidence-based timeline and research questions&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#F3F4F6;fontSize=18;align=center;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="35" y="565" width="530" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9CA3AF;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="review" target="analysis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9CA3AF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analysis" target="extraction">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9CA3AF;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="extraction" target="synthesis">
          <mxGeometry relative="1" as="geometry"/>
