<mxfile host="app.diagrams.net" modified="2026-11-11T14:50:00.000Z" agent="diagrams.net" version="24.7.17" type="device">
  <diagram id="research-pipeline" name="Research pipeline">
    <mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1000" background="#000000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="HOW LARVAL CONNECTOME RESEARCH BECAME POSSIBLE" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#F3F4F6;" vertex="1" parent="1">
          <mxGeometry x="25" y="20" width="1150" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Systematic review: from search and screening to the historical development of scanning and reconstruction." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=17;fontColor=#D1D5DB;" vertex="1" parent="1">
          <mxGeometry x="35" y="78" width="1130" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;1. SYSTEMATIC LITERATURE REVIEW&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A5C8FF&quot;&gt;IN PROGRESS - ASREVIEW LAB SCREENING&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;Search: Scopus API + Web of Science website&lt;br&gt;2015-2024: 568 -&gt; 184 duplicates -&gt; 384 unique&lt;br&gt;Full set (554): 32 relevant | 507 excluded | 15 unclear&lt;br&gt;2015-2024 subset: 21 | 354 | 9&lt;br&gt;Excluded records have documented reasons&lt;br&gt;&lt;b&gt;Next:&lt;/b&gt; resolve unclear items and assess full texts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#F3F4F6;fontSize=18;align=center;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="35" y="155" width="530" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="analysis" value="&lt;b&gt;2. HISTORICAL MILESTONES&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A5C8FF&quot;&gt;NEXT: EXTRACT FROM INCLUDED STUDIES&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;Trace the enabling steps reported in the literature:&lt;br&gt;Electron-microscopy imaging and larger image volumes&lt;br&gt;Image alignment, segmentation, neuron tracing&lt;br&gt;Synapse identification, proofreading, validation&lt;br&gt;Record dates, methods, organisms/stages, and scale&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; evidence-based timeline of how scanning and reconstruction advanced&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#F3F4F6;fontSize=18;align=center;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="635" y="155" width="530" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="ablation" value="&lt;b&gt;3. QUANTITATIVE COMPARISON&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A5C8FF&quot;&gt;THEN: SYNTHESIZE EXTRACTED EVIDENCE&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;Compare reported connectome scale across milestones:&lt;br&gt;Neurons, synapses, image volume, and brain-region coverage&lt;br&gt;Imaging and reconstruction methods used at each stage&lt;br&gt;Map how scale and coverage changed over time&lt;br&gt;Distinguish measured values from author claims&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; quantitative tables/plots of technical progress&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#F3F4F6;fontSize=18;align=center;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="635" y="565" width="530" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="evaluation" value="&lt;b&gt;4. HISTORICAL SYNTHESIS &amp;amp; GAPS&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#A5C8FF&quot;&gt;FINAL REVIEW OUTPUT&lt;/font&gt;&lt;hr&gt;&lt;div align=&quot;left&quot;&gt;Explain how advances made large-scale larval connectomics possible&lt;br&gt;Identify bottlenecks: imaging, scale, annotation, validation&lt;br&gt;Summarize what is covered and what remains incomplete&lt;br&gt;Relate the milestones to the goal of a more complete connectome&lt;br&gt;&lt;b&gt;Output:&lt;/b&gt; evidence-based historical account and research gaps&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;strokeWidth=2;fontColor=#F3F4F6;fontSize=18;align=center;verticalAlign=top;spacing=16;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="35" y="565" width="530" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9CA3AF;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="review" target="analysis">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9CA3AF;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="analysis" target="ablation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;strokeColor=#9CA3AF;endArrow=block;endFill=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="ablation" target="evaluation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="footer" value="This is a systematic review of historical progress, not a new connectome graph/ablation experiment." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#181818;strokeColor=#9CA3AF;fontColor=#D1D5DB;fontSize=17;fontStyle=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="35" y="925" width="1130" height="48" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
